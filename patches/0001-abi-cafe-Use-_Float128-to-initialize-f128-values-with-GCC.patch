From 0969e3204832939663a226ed4dc26f2360346086 Mon Sep 17 00:00:00 2001
From: Dummy <dummy@example.com>
Date: Thu, 5 Nov 2026 20:31:33 +0000
Subject: [PATCH] Use _Float128 to initialize f128 values with GCC

The declarations of f128 values use _Float128 with GCC, but the union that
initializes them used __float128, which GCC does not have on aarch64.
---
 src/toolchains/c/init.rs | 8 +++++++-
 1 file changed, 7 insertions(+), 1 deletion(-)

diff --git a/src/toolchains/c/init.rs b/src/toolchains/c/init.rs
index 1c3f629..9b3a1c6 100644
--- a/src/toolchains/c/init.rs
+++ b/src/toolchains/c/init.rs
@@ -81,9 +81,15 @@ impl CcToolchain {
                     let val = val.generate_u128();
                     let lower = val & 0x0000_0000_0000_0000_FFFF_FFFF_FFFF_FFFF;
                     let higher = (val & 0xFFFF_FFFF_FFFF_FFFF_0000_0000_0000_0000) >> 64;
+                    // Use the same type name as the declarations. GCC doesn't have `__float128`
+                    // on aarch64.
+                    let ty = match self.cc_flavor {
+                        CCFlavor::Gcc => "_Float128",
+                        _ => "__float128",
+                    };
                     write!(
                         f,
-                        "(((union {{ __uint128_t bits; __float128 value; }}){{ .bits = ((__uint128_t){lower:#X}ull) | (((__uint128_t){higher:#X}ull) << 64) }}).value)"
+                        "(((union {{ __uint128_t bits; {ty} value; }}){{ .bits = ((__uint128_t){lower:#X}ull) | (((__uint128_t){higher:#X}ull) << 64) }}).value)"
                     )?
                 }
             },
